# ============================================================
# متغيرات البيئة - الواجهة الأمامية (React + Vite)
# ============================================================
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك (تطوير/إنتاج)
#
# ⚠️ ملاحظة: Vite يطلب أن تبدأ أي متغيرة تريد الوصول إليها من كود المتصفح
# بالبادئة VITE_ فقط. لهذا السبب نستخدم VITE_API_BASE_URL وليس REACT_APP_*
# (البادئة REACT_APP_ خاصة بمشاريع Create React App وليست هذا المشروع).

# رابط الـ API الأساسي لخادم Laravel (بدون شرطة مائلة في النهاية)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# مثال على بيئة إنتاج:
# VITE_API_BASE_URL=https://api.yourschool.com/api
